{
  "name": "task-workflow",
  "version": "2.10.0",
  "description": "Wayfinder grilling → task frontier → type-specific execution — a planning workflow for docs/tasks/. Pi extension.",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "yaml": "^2.6.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "pi-subagents": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.3",
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@types/node": "^20.11.0",
    "pi-subagents": "0.34.0",
    "svelte": "^5.56.10",
    "typebox": "^1.3.4",
    "typescript": "^5.6.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2.1.0"
  },
  "pi": {
    "extensions": [
      "./src/pi.ts"
    ],
    "skills": [
      "./skills/engineering/task-overview",
      "./skills/engineering/onboard-workflow",
      "./skills/engineering/wayfinder",
      "./skills/engineering/implement-task",
      "./skills/engineering/finalize-task",
      "./skills/engineering/report-bug",
      "./skills/engineering/tdd",
      "./skills/engineering/code-review",
      "./skills/engineering/task-workflow-doctor",
      "./skills/engineering/diagnosing-bugs",
      "./skills/engineering/codebase-design",
      "./skills/engineering/grilling",
      "./skills/engineering/grilling-with-ui",
      "./skills/engineering/domain-modeling",
      "./skills/engineering/improve-codebase-architecture",
      "./skills/productivity/wait-what",
      "./skills/engineering/skill-creator"
    ],
    "subagents": {
      "agents": [
        "./agents"
      ]
    }
  }
}
