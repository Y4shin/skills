{
  "name": "@y4shin/pi-task-workflow",
  "version": "5.4.0",
  "description": "Wayfinder grilling → task frontier → type-specific execution: a planning workflow for docs/tasks/. Pi extension.",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Y4shin/skills.git"
  },
  "homepage": "https://github.com/Y4shin/skills#readme",
  "files": [
    "src",
    "skills",
    "agents",
    "CHANGELOG.md",
    "CONTEXT.md",
    "docs/engineering",
    "docs/productivity",
    "docs/adr",
    "docs/repo-gating.md",
    "docs/git-workflows.md",
    "docs/dev-env.md",
    "docs/testing.md",
    "docs/migration-target.yaml"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "changeset": "changeset",
    "version": "changeset version",
    "evals:corpus": "node evals/corpus.ts",
    "evals:score": "node evals/score.ts",
    "evals:report": "node evals/report.ts",
    "evals:spend": "node evals/spend.ts",
    "typecheck:evals": "tsc -p evals/tsconfig.json",
    "evals:calibrate": "node evals/calibrate.ts",
    "evals:regenerate": "node evals/regenerate.ts"
  },
  "dependencies": {
    "@changesets/apply-release-plan": "^8.1.1",
    "@changesets/assemble-release-plan": "^7.0.0",
    "@changesets/changelog-git": "^1.0.0",
    "@changesets/config": "^4.0.1",
    "@changesets/git": "^4.0.1",
    "@changesets/read": "^1.0.1",
    "@changesets/types": "^7.0.0",
    "@changesets/write": "^1.0.1",
    "@manypkg/get-packages": "^3.1.0",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@y4shin/pi-telemetry": "^0.4.2",
    "pi-subagents": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@changesets/parse": "^1.0.0",
    "@earendil-works/pi-ai": "^1.0.3",
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@types/node": "^24.19.2",
    "pi-subagents": "^0.84.0",
    "typebox": "^1.4.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "undici": "^8.12.3"
  },
  "pi": {
    "extensions": [
      "./src/pi.ts"
    ],
    "skills": [
      "./skills/engineering/task-workflow-overview",
      "./skills/engineering/setup-workflow",
      "./skills/engineering/intake",
      "./skills/engineering/wayfinder",
      "./skills/engineering/implement-ticket",
      "./skills/engineering/finalize-effort",
      "./skills/engineering/tdd",
      "./skills/engineering/code-review",
      "./skills/engineering/task-workflow-doctor",
      "./skills/engineering/workflow-failure",
      "./skills/engineering/diagnosing-bugs",
      "./skills/engineering/codebase-design",
      "./skills/engineering/grilling",
      "./skills/engineering/domain-modeling",
      "./skills/engineering/improve-codebase-architecture",
      "./skills/productivity/wait-what",
      "./skills/engineering/skill-creator",
      "./skills/engineering/skill-review",
      "./skills/engineering/prototype",
      "./skills/engineering/research",
      "./skills/engineering/resolving-merge-conflicts",
      "./skills/engineering/pr",
      "./skills/engineering/wizard",
      "./skills/productivity/handoff",
      "./skills/productivity/to-questionnaire",
      "./skills/productivity/teach",
      "./skills/productivity/writing-for-agents",
      "./skills/productivity/operator-communication",
      "./skills/productivity/grill-me",
      "./skills/engineering/to-spec",
      "./skills/engineering/to-tickets",
      "./skills/engineering/eval-review"
