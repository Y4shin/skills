{
  "name": "task-workflow",
  "version": "2.7.1",
  "description": "Wayfinder grilling → task frontier → type-specific execution — a planning workflow for docs/tasks/. Pi extension.",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "yaml": "^2.6.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "pi-subagents": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.3",
    "@types/node": "^20.11.0",
    "pi-subagents": "0.34.0",
    "typebox": "^1.3.4",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "pi": {
    "extensions": [
      "./src/pi.ts"
    ],
    "skills": [
      "./skills/task-overview",
      "./skills/onboard-workflow",
      "./skills/wayfinder",
      "./skills/implement-task",
      "./skills/finalize-task",
      "./skills/report-bug",
      "./skills/tdd",
      "./skills/code-review",
      "./skills/task-workflow-doctor",
      "./skills/diagnosing-bugs",
      "./skills/codebase-design",
      "./skills/grilling",
      "./skills/domain-modeling",
      "./skills/improve-codebase-architecture"
    ],
    "subagents": {
      "agents": [
        "./agents"
      ]
    }
  }
}
