{
  "name": "task-workflow",
  "version": "1.0.9",
  "description": "Task workflow: task → slices → TDD → finalize. Pi extension.",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "smol-toml": "^1.3.1",
    "yaml": "^2.6.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "pi-subagents": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.80.3",
    "@earendil-works/pi-coding-agent": "^0.80.3",
    "@types/node": "^20.11.0",
    "typebox": "^1.3.4",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "pi": {
    "extensions": [
      "./src/pi/index.ts",
      "./src/pi/guidelines.ts",
      "./src/pi/check-subagents.ts"
    ],
    "skills": [
      "./skills/create-task",
      "./skills/finalize-task",
      "./skills/implement-slice",
      "./skills/migrate-workflow",
      "./skills/onboard-workflow",
      "./skills/resume-workflow",
      "./skills/start-slice",
      "./skills/task-workflow-overview"
    ],
    "subagents": {
      "agents": [
        "./agents"
      ]
    }
  }
}
